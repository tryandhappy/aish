# aish configuration file
# Default path: ~/.aish/config.toml
#
# このサンプルの設定値はすべて aish の既定値と一致しています。必要に応じて
# 該当行のコメント `#` を外して上書きしてください。section ヘッダ (`[display]` 等) は
# キーがどの table に属するかが分かるように **コメントアウトせず残してあります**。
# section の中身を一切上書きしないなら、section ヘッダ自体は無くても aish は動きます。

# Global system prompt (default)
# system_prompt = "あなたはLinuxサーバ管理の専門家です。SSHセッションの内容を把握しています。"

# AI response language (default: "Japanese", empty to disable)
# language = "Japanese"

# Display settings
# Colors: ANSI escape sequences (use \u001B for ESC in TOML)
#         e.g. "\u001B[36m" (cyan fg), "\u001B[43m" (yellow bg), "\u001B[38;5;208m" (256-color)
#         fg+bg combined: "\u001B[38;5;208;48;5;238m"
#         or "" (empty) for terminal default
[display]
# shell_prefix_label = "[aish]"                                  # default: "[aish]" — status bar label
# header_color = "\u001B[38;5;208m"                              # default: "\u001B[38;5;208m" (orange) — status bar / banner
# prompt_label = "[aish]"                                        # default: "[aish]" — aish prompt (Ctrl+/) label
# prompt_color = "\u001B[38;5;208;48;2;50;35;20m"                # default: orange text, dark brown bg
# thinking_message = "Thinking..."                               # default: "Thinking..."
# thinking_color = "\u001B[38;5;208m"                            # default: "\u001B[38;5;208m" (orange)
# ai_color = "\u001B[38;5;216m"                                  # default: "\u001B[38;5;216m" (light orange)
# input_color = ""                                               # default: "" (terminal default)
# confirm_color = "\u001B[38;5;228;48;5;239m"                    # default: pale yellow text, gray bg

# Terminal-level "aish is running" indicators (OSC 10/11/12).
# Format: "#rrggbb" or "rgb:rr/gg/bb" — color specs sent to the terminal itself, NOT ANSI SGR.
# Empty string disables that channel (terminal default is kept).
# These do NOT consume any screen rows/cols, so they don't conflict with fullscreen apps,
# scroll regions, or `clear`.
# term_fg_color = ""                                             # default: "" — OSC 10 default foreground
# term_bg_color = ""                                             # default: "" — OSC 11 default background
# term_cursor_color = "#ff8800"                                  # default: "#ff8800" (orange) — OSC 12 cursor color

# Logging settings
# Log Claude Code CLI commands and responses
[log]
# enabled = false                                                # default: false
# path = "~/.aish/logs/claude-code.log"                          # default: "~/.aish/logs/claude-code.log"

# AI backend settings
# `backend` selects which CLI to drive. `--ai <kind>` (CLI flag) overrides this.
# Supported: claude (Claude Code), codex (OpenAI Codex CLI), gemini (Google Gemini CLI),
#            qwen (Alibaba Qwen Code), cursor (Cursor Agent CLI / `cursor-agent`),
#            copilot (GitHub Copilot CLI), cloudflare (Cloudflare Workers AI; REST を curl で呼ぶ).
# `system_prompt` / `language` here override the top-level values; if empty, the
# top-level values above are used (backward compatibility).
[ai]
# backend = "claude"                                             # default: "claude" — claude|codex|gemini|qwen|cursor|copilot|cloudflare, or any [[ai.providers]].name
# model = ""                                                     # default: "" — モデル名 (例: "sonnet", "gpt-5", "gemini-2.5-pro")
                                                               # `--model <NAME>` (CLI) > [ai].model > extra_args の -m 指定 の順で優先
                                                               # 空のときはバックエンド CLI 既定のモデルが使われる
# effort = ""                                                    # default: "" — reasoning effort レベル (例: "low" | "medium" | "high")
                                                               # `--effort <LEVEL>` (CLI) > [ai].effort の順で優先
                                                               # claude → `--effort <level>`, codex → `-c model_reasoning_effort=<level>` に変換
                                                               # copilot → `--effort <level>` (native 対応、none/low/medium/high/xhigh/max)
                                                               # gemini / qwen / cursor は該当 CLI フラグが無いので無視される
# system_prompt = ""                                             # default: "" — falls back to top-level system_prompt
# language = ""                                                  # default: "" — falls back to top-level language

# ---------------------------------------------------------------------------
# /model /effort の候補リスト (対話ピッカー)
# ---------------------------------------------------------------------------
# 下の各 backend テーブル ([ai.claude] / [ai.codex] / [ai.gemini] / [ai.qwen] /
# [ai.cursor] / [ai.copilot] と [[ai.providers]]) で、以下 4 キーを設定できる。
# `/model` `/effort` を引数なしで実行すると候補から ↑↓ + Enter で選べる
# (`-` または `clear` でクリア、任意値の直接指定も可)。
#   models          : model 候補 (static list)。例: ["claude-opus-4-8", "claude-sonnet-4-6"]
#   models_command  : model 候補を動的取得するコマンド (ローカルで sh -c、stdout 1 行 1 候補)
#   efforts         : effort 候補 (static list)。例: ["low", "medium", "high"]
#   efforts_command : effort 候補を動的取得するコマンド
# 優先順位: static list > 取得コマンド > backend 組み込み既定。
# effort の組み込み既定: claude=low/medium/high, codex=minimal/low/medium/high,
#   copilot=none/low/medium/high/xhigh/max (gemini/qwen/cursor は無し)。
# model の組み込み既定: 全 native backend に同梱済み (config 無しでも /model でピッカーが開く)。
#   モデル名は流動的なので best-effort。最新版に合わせたい / 別モデルを使いたい場合は
#   下の models = [...] で上書きする (generic [[ai.providers]] は recipe 由来のみで既定なし)。

[ai.claude]
# models = ["claude-opus-4-8", "claude-sonnet-4-6", "claude-haiku-4-5"]
# efforts = ["low", "medium", "high"]                            # 省略時は組み込み既定が使われる
# models_command = "claude --list-models"                        # 例: CLI から動的取得 (1 行 1 候補)
# disallowed_tools = "Bash,Edit,Write,Read"                      # default: "Bash,Edit,Write,Read" — これに追加する形。
                                                                 # Bash/Edit/Write は allow_unsafe_tools=false の間は常に deny される
                                                                 # (空文字にしても剥がれない)。Read だけは外せる。
# allow_unsafe_tools = false                                     # default: false。true で baseline 強制を解除し disallowed_tools を
                                                                 # そのまま渡す。AI に shell 実行/編集を許す危険設定。通常は触らない。
# extra_args = []                                                # default: [] — extra args appended to `claude -p ...`。
                                                                 # 注: --disallowedTools は args 末尾で必ず付与されるので、ここに
                                                                 # --disallowedTools を書いても上書きできない。値の調整は上の項目で。

# Codex / Gemini / Qwen / Cursor don't have JSON-schema flags, so JSON output is enforced via system prompt.
# Use extra_args for model selection or other CLI-specific flags.
[ai.codex]
# extra_args = []                                                # e.g. ["-m", "gpt-5.5"]

[ai.gemini]
# extra_args = []                                                # e.g. ["-m", "gemini-2.5-pro"]

[ai.qwen]
# extra_args = []

# Cursor Agent CLI (`cursor-agent`). aish は `-p --output-format json --trust` で都度呼び出す。
# --trust は headless モードで必須なので aish が常に自動で付与する (config からは指定不可)。
#
# cursor-agent はファイル編集 / shell 実行ツールを内蔵しているが、aish は codex のような
# 個別ツール無効化フラグを使えないため、ツール抑制は次の二段構えで行う:
#   1. `mode = "plan"`  — cursor-agent の read-only / planning モード (no edits)。aish の用途と一致する安全プリミティブ
#   2. system prompt の best-effort 指示 (build_system_prompt が自動付与)
#
# `sandbox` で `--sandbox enabled` を渡せば OS レベルの defense-in-depth が追加できる (任意)。
#
# 注意: cursor-agent free プランでは Named models が使えないため、`model = "auto"` 設定 (もしくは
# 起動時の `--model auto`) が必須。paid プランなら "sonnet-4" 等の named model を指定できる。
[ai.cursor]
# extra_args = []                                                # e.g. ["--model", "auto"] (paid plan なら不要)
# mode = "plan"                                                  # default: "plan" — "plan" (read-only) / "ask" (Q&A only) / "" (通常モード = 危険)
# sandbox = ""                                                   # default: "" — "enabled" / "disabled" を cursor-agent --sandbox にそのまま渡す。defense-in-depth

# Cloudflare Workers AI (`--ai cloudflare`)。REST API を `curl` で叩く native backend
# (aish の自己アップデートと同じ curl サブプロセス方式。追加依存なし)。実行には curl が必要。
#
# 認証情報は **環境変数のみ** (config.toml は平文なのでトークンを書かせない):
#   export CLOUDFLARE_ACCOUNT_ID=...    # Cloudflare の Account ID (必須)
#   export CLOUDFLARE_API_TOKEN=...     # Workers AI 権限のある API Token (必須)
#   export CLOUDFLARE_MODEL=...         # 既定モデルの上書き (任意。未設定なら @cf/meta/llama-3.1-8b-instruct)
#
# model は [ai].model / `/model` でも指定可 (env CLOUDFLARE_MODEL より優先)。コマンド提案の質は
# モデル依存: {message, commands} の JSON 出力に追従できる大きめ instruct モデル
# (例 @cf/meta/llama-3.3-70b-instruct-fp8-fast) を推奨。セクション名はハイフン形 (cloudflare-workers-ai) に注意。
[ai.cloudflare-workers-ai]
# models = ["@cf/meta/llama-3.3-70b-instruct-fp8-fast", "@cf/meta/llama-3.1-8b-instruct"]  # 省略時は組み込み既定
# models_command = ""                                            # 例: 動的取得 (1 行 1 候補)

# ===========================================================================
# 組み込みデフォルト recipe (zero-config) — `aish --list-providers` で一覧表示
# ===========================================================================
# 人気 AI CLI は **設定不要** で `--ai <name>` / `/ai <name>` 指定だけで使える。
# 同梱 recipe は aish が著者として read-only / plan 相当の安全フラグを焼き込んでいる
# (read-only を強制できない CLI は同梱しない)。現在の同梱一覧:
#
#   kimi   : MoonshotAI/kimi-cli。args=["--plan","--quiet"] (--plan=read-only tools)、
#            model_flag="--model"。NOTE: prompt 渡し方・最終出力フォーマットは
#            kimi-cli インストール環境での実機検証が必要。挙動が違えば下記 [[ai.providers]]
#            で上書きすること。
#
#   opencode : OpenCode (anomalyco/opencode, 旧 sst/opencode)。`opencode run --agent aish`
#            + 環境変数 `OPENCODE_CONFIG_CONTENT` (recipe の `env` で注入) により
#            edit/bash/task/todowrite を deny した専用 agent で headless 実行する
#            (deny されたツールはツールセットから除去される。v1.17.13 で実機検証済み)。
#            read / webfetch / websearch は許可。model_flag="--model" (provider/model
#            形式)、effort_flag="--variant"、モデル候補は `opencode models` から取得。
#            注意: `--auto` (auto-approve) は絶対に args に足さないこと。built-in の
#            `plan` agent は deny でなく ask ベースで headless ではハングするので
#            `--agent plan` に変えないこと。バイナリ名 `opencode` は旧 Go 版
#            opencode (現 charmbracelet/crush) と衝突しうるので `which -a opencode`
#            で実体を確認すること。
#
# 上書きは「書いたフィールドだけ」効く (フィールド単位マージ)。例: kimi のモデル指定だけ
# 変えたいなら:
#   [[ai.providers]]
#   name = "kimi"
#   model_flag = "-m"        # 他フィールド (binary/args 等) は組み込み既定のまま
#
# 注意: `args` は Vec なので「丸ごと置換」(部分マージはしない)。
#
# ===========================================================================
# [[ai.providers]] — 組み込みデフォルトの上書き / 新規 CLI backend の追加
# ===========================================================================
# 配列形式で複数 provider を登録できる (解決後の合計が上限 256 個)。各エントリの `name`
# をそのまま `--ai <name>` / `/ai <name>` で指定する (built-in と同じ平坦な名前空間)。
#
#   - `name` が組み込みデフォルト recipe と一致 → 指定フィールドだけ上書き
#   - 一致しない → 新規 generic backend (このとき `binary` 必須)
#
# **`name` に native 予約語 (claude / codex / gemini / qwen / cursor / copilot) を
# 使うと起動時エラー**。
#
# 新規 provider の安全性は aish 側からは強制しない (claude/copilot のような自動 deny
# フラグ無し)。**登録する CLI が信頼できることを利用者が確認した上で使うこと**。必要なら
# `args` に `--mode plan` 等の安全フラグを明示的に含める。
#
# フィールド:
#   name              : 一意な識別子 (例 "ollama-llama"). built-in 予約語と衝突不可
#   binary            : 実行ファイル (PATH 検索 or 絶対パス)
#   args              : 固定引数 (動的引数は後ろに追加される)
#   env               : 子プロセスに追加する環境変数 (例 env = { KEY = "value" })。
#                       上書き時は args と同じく丸ごと置換 (キー単位マージなし)
#   prompt_delivery   : "stdin" (推奨) | "arg" (末尾 positional) | "flag" (prompt_flag の値として)
#   prompt_flag       : prompt_delivery="flag" のときのフラグ名 (例 "-p")
#   parse             : "lossy" | "extract_json" | "jsonl"
#   jsonl_content_path: parse="jsonl" のとき "type:dot.path" 形式 (例 "assistant.message:data.content")
#   jsonl_session_path: parse="jsonl" のとき session_id 用 "type:dot.path"
#   session_id_path   : parse="extract_json" のとき抽出 JSON 内の session_id フィールド名
#   resume_flag       : session_id 捕獲時に再開で渡す引数 (例 "--resume"). 空なら native resume なし
#   model_flag        : model 指定引数名 (例 "--model" / "-m"). 空なら model 渡しなし
#   effort_flag       : reasoning effort 引数名. 空なら保存のみで反映しない
#   color             : 256-color の数値 (default 208 = orange)
#   system_prompt_inline: true=初回 prompt 先頭に焼き込む (default), false=毎回履歴ベースで再送
#   history_turns     : native resume 無し時に保持する (user, ai) ターン数 (default 8)
#
# 例 1: ollama 経由のローカル LLM (内部 history fallback) → `aish --ai ollama-llama`
# [[ai.providers]]
# name = "ollama-llama"
# binary = "ollama"
# args = ["run", "llama3.2"]
# prompt_delivery = "stdin"
# parse = "lossy"
# color = 42
#
# 例 2: 仮想的な native-resume 対応 CLI → `aish --ai local-llm`
# [[ai.providers]]
# name = "local-llm"
# binary = "local-llm-cli"
# args = ["chat", "--format", "json"]
# prompt_delivery = "stdin"
# parse = "extract_json"
# session_id_path = "session_id"
# resume_flag = "--resume"
# model_flag = "--model"
# color = 39
#
# 例 3: xAI Grok Build (`grok`, https://x.ai/cli) → `aish --ai grok`
# 同梱していない理由: headless (`-p`) 実行時に write ツールが確認なしで拒否される
# ことをドキュメント/実機で確認できなかった (plan mode の read-only 強制は TUI の
# Shift+Tab のみ文書化されており、headless 既定の permission_mode="ask" が非対話
# 実行でどう振る舞うかは未検証)。使う場合は必ず自分の環境で検証すること:
# 空の scratch ディレクトリで `grok -p "<書き込みを促す指示>" --output-format json`
# を `--always-approve` 無しで実行し、ファイルが変更されないことを確認してから使う。
# `--always-approve` は絶対に args に含めないこと。
# 注意: `grok` はコミュニティ製 `@vibe-kit/grok-cli` (npm, xAI API 直叩き、read-only
# モード無し) ともバイナリ名が衝突する。`which -a grok` で実体を確認すること。
# [[ai.providers]]
# name = "grok"
# binary = "grok"
# args = ["--output-format", "json"]
# prompt_delivery = "flag"
# prompt_flag = "-p"
# parse = "extract_json"          # 出力 JSON のトップレベルキー構成は要実機確認
# model_flag = "-m"
# color = 45

# GitHub Copilot CLI (`copilot`). aish は以下の必須安全フラグを常に自動付与する (config 指定不可):
#   --output-format json   (JSONL 形式の応答)
#   --allow-all-tools      (非対話モードで必須)
#   --deny-tool=shell      (信頼の根幹: shell 実行を完全拒否; deny は --allow-all-tools に優先)
#   --deny-tool=write      (信頼の根幹: ファイル書き込みを完全拒否)
#   --no-ask-user          (会話は aish が仕切る; copilot 側から user に質問させない)
# つまり copilot は「LLM のみ」に退化させた状態で動作する (claude / codex 相当の堅さ)。
#
# 認証は `gh auth login` か `copilot login` 経由、もしくは COPILOT_GITHUB_TOKEN /
# GH_TOKEN / GITHUB_TOKEN env のいずれか。所属組織の Copilot ポリシーで CLI 利用が
# 許可されている必要がある。
[ai.copilot]
# extra_args = []                                                # e.g. ["--disable-builtin-mcps"]
# mode = "plan"                                                  # default: "plan" — "plan" / "interactive" / "autopilot" / "" (mode 指定なし)
